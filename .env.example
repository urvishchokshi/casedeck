# Supabase — copy to .env.local and fill in real values (never commit .env.local).

# Project URL from Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key (safe for the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key (server-only — never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical site origin, no trailing slash — REQUIRED in production (Vercel).
# Used for auth redirect URLs and metadata. When unset, falls back to the
# request origin → VERCEL_URL (previews) → http://localhost:3000 (dev).
NEXT_PUBLIC_SITE_URL=https://your-domain.example.com
