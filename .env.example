# Supabase — NOT USED YET. These will be wired up in a later phase
# (Supabase schema + Microsoft auth). Documented here so the shape of
# .env.local is known in advance.

# Project URL from Supabase dashboard → Settings → API
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key (safe for the browser)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key (server-only — never expose to the browser)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
