# Supabase — copy to .env.local and fill in real values (never commit .env.local).

# Project URL from Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key (safe for the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key (server-only — never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical site origin, no trailing slash — REQUIRED in production (Vercel).
# Used for auth redirect URLs and metadata. When unset, falls back to the
# request origin → VERCEL_URL (previews) → http://localhost:3000 (dev).
NEXT_PUBLIC_SITE_URL=https://your-domain.example.com

# Gemini — powers "Practice with AI" voice interviews on /cases/[id].
# Server-only: the browser only ever receives single-use ephemeral tokens.
# Key from https://aistudio.google.com/apikey. Without it the voice
# interviewer answers "not set up" (the copy-prompt fallback still works).
GEMINI_API_KEY=your-gemini-api-key
# Optional overrides (defaults shown):
# GEMINI_LIVE_MODEL=gemini-3.8-live
# GEMINI_NOTES_MODEL=gemini-3.8-flash
# GEMINI_LIVE_VOICE=Charon
